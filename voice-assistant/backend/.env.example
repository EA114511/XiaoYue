# =============================================
# AI语音助手 - 环境变量配置模板
# 复制此文件为 .env 并填写真实配置
# cp .env.example .env
# =============================================

# ---------- 服务器配置 ----------
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ---------- CORS 跨域配置 ----------
# 允许多个前端地址，用逗号分隔
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- OpenAI API 配置 ----------
# 从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
# 可选: gpt-4, gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# ---------- 语音识别 (ASR) 配置 ----------
# 识别引擎: whisper
ASR_ENGINE=whisper
# Whisper 模型大小: tiny / base / small / medium / large
WHISPER_MODEL_SIZE=base
# 默认识别语言: zh / en / ja
ASR_DEFAULT_LANGUAGE=zh
# WebRTC VAD 灵敏度: 0-3 (值越小越敏感)
VAD_SENSITIVITY=2

# ---------- 天气 API 配置 ----------
# 使用 OpenWeatherMap API: https://openweathermap.org/api
WEATHER_API_KEY=your-weather-api-key-here
WEATHER_API_URL=http://api.openweathermap.org/data/2.5
WEATHER_UNITS=metric

# ---------- 数据库配置 ----------
# 默认使用 SQLite，可切换为 PostgreSQL
DATABASE_URL=sqlite:///./data/voice_assistant.db
# PostgreSQL 示例:
# DATABASE_URL=postgresql://user:password@localhost:5432/voice_assistant

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_FILE=logs/voice_assistant.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ---------- API Key 加密配置 ----------
# 用于加密持久化存储的 API Key（如不设置，Key 将以明文存储！）
# 生产环境必须设置，可使用任意字符串：
#   python -c "import secrets; print(secrets.token_hex(32))"
CRYPTO_KEY=
